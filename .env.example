# Bu dosyayı kopyala ve .env adıyla kaydet:
#   cp .env.example .env
# .env asla commit edilmez (bkz. .gitignore).

# --- Postgres (docker-compose.yml bunları okur) ---
POSTGRES_USER=canny
POSTGRES_PASSWORD=canny
POSTGRES_DB=canny_mini
POSTGRES_PORT=5432

# --- Redis ---
REDIS_PORT=6379

# --- apps/api tarafından kullanılacak (Faz 1'de bağlanacak) ---
DATABASE_URL="postgresql://canny:canny@localhost:5432/canny_mini"
REDIS_URL="redis://localhost:6379"

# --- Faz 7.1 — integration testleri (apps/api/test/integration) ---
# Integration testleri GERÇEK bir Postgres'e karşı çalışır ve her test
# dosyası arasında TRUNCATE atar — bu yüzden ASLA geliştirme veritabanını
# kullanmazlar. Bu değişkeni vermezsen yukarıdaki DATABASE_URL'den "_test"
# ekiyle türetilir (canny_mini -> canny_mini_test) ve veritabanı yoksa
# `prisma migrate deploy` ile otomatik oluşturulur.
# NOT: Bu değişken bu dosyadan DEĞİL, kabuk/CI ortamından okunur (testler
# ConfigModule'den önce çalışır) — burada sadece belge amaçlı duruyor.
# TEST_DATABASE_URL="postgresql://canny:canny@localhost:5432/canny_mini_test"

# --- Faz 7.2 — E2E testleri (apps/e2e, Playwright) ---
# E2E kendi api (:3334) ve web (:3001) sunucularını AYRI portlarda ayağa
# kaldırır (dev sunucularına dokunmaz) ve ayrı bir veritabanı kullanır.
# Verilmezse DATABASE_URL'den "_e2e" ekiyle türetilir; adı "_e2e" ile
# bitmiyorsa koşu hiç başlamaz. Bu da kabuk/CI ortamından okunur.
# E2E_DATABASE_URL="postgresql://canny:canny@localhost:5432/canny_mini_e2e"

# --- Auth secrets — KENDİN ÜRET, aşağıdaki placeholder'lar KASTEN çalışmaz ---
# Access ve refresh için AYRI, yüksek-entropili birer değer üret:
#   node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
# (ya da: openssl rand -hex 32). İkisi FARKLI olmalı.
# Bu __GENERATE_ME__ değerleri bırakılırsa uygulama production'da boot ETMEZ
# ve dev'de yüksek sesle uyarır (bkz. apps/api/src/config/env.validation.ts) —
# "kopyala-yapıştır çalışıyor" tuzağına düşülmesin diye bilinçli.
JWT_ACCESS_SECRET=__GENERATE_ME__access
JWT_REFRESH_SECRET=__GENERATE_ME__refresh
JWT_ACCESS_EXPIRES_IN=15m
JWT_REFRESH_EXPIRES_IN=7d

# --- Faz 7.4 — rate limiting ---
# Genel limit: her IP için, THROTTLE_TTL_MS'lik pencerede en fazla
# THROTTLE_LIMIT istek. Auth uçları (login/register/widget identify) ayrıca
# ve kod seviyesinde daha dar bir limite tabi (bkz.
# apps/api/src/common/throttler.constants.ts → AUTH_THROTTLE).
THROTTLE_TTL_MS=60000
THROTTLE_LIMIT=120
# Sadece test harness'ı set eder (integration testleri aynı IP'den onlarca
# giriş yapıyor). Uygulamayı çalıştırırken ASLA true yapma.
# THROTTLE_DISABLED=false

# --- apps/api HTTP sunucusu ---
PORT=3333
# Virgülle ayrılmış birden fazla origin kabul eder — apps/web (:3000),
# apps/widget dev sunucusu (:5173) ve `vite preview`/embed script testleri
# (:5174, Faz 4.2) ikisi de local'de aynı anda çağırabilmeli.
WEB_ORIGIN=http://localhost:3000,http://localhost:5173,http://localhost:5174
# trust proxy — SADECE bir reverse-proxy/load balancer arkasına deploy
# edilirse set et (sayı = güvenilen hop sayısı, ör. 1). Boş bırakılırsa
# kapalı: X-Forwarded-For yok sayılır, rate-limit gerçek soket IP'sini
# kullanır (spoofing'e kapalı). Local'de boş bırakılmalı.
# TRUST_PROXY=1
NODE_ENV=development

# --- Faz 6.1 — Billing (Stripe hesabı YOK).
# MockStripeClient'ın webhook gövdesini (POST /billing/webhook) imzalamak
# için kullandığı HMAC anahtarı — gerçek Stripe'ta bu, Stripe Dashboard'un
# webhook endpoint'i için ürettiği `whsec_...` değeridir. Local'de rastgele
# herhangi bir değer olabilir ama KENDİN üret (aşağıdaki placeholder kasten
# çalışmaz — üstteki auth secret'larıyla aynı gerekçe):
#   node -e "console.log('whsec_'+require('crypto').randomBytes(24).toString('hex'))"
STRIPE_WEBHOOK_SECRET=__GENERATE_ME__whsec
