# Bu dosyayı kopyala ve .env.local adıyla kaydet (opsiyonel):
#   cp .env.example .env.local
# Vite sadece apps/widget altındaki .env* dosyalarını okur. Belirtilmezse
# src/lib/api.ts içindeki varsayılan (http://localhost:3333) apps/api'nin
# varsayılan PORT'uyla zaten eşleşiyor, bu yüzden local dev'de bu dosya
# olmadan da çalışır (apps/web/.env.example ile aynı desen).
VITE_API_URL=http://localhost:3333
